{
  "name": "zuiqiang-shuiguo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "《最强水果》Phase 01 — Physics Foundation / Battle Runtime / Physics Lab",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host 0.0.0.0",
    "dev:player": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "build:wechat": "vite build -c vite.wechat.config.ts",
    "build:wechat:rca": "node scripts/wechat-rca.js",
    "dev:wechat": "node scripts/wechat-dev.js",
    "build:pages": "vite build -c vite.pages.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e-gate": "npm run build:pages && node tests/_serve_pages.cjs & node tests/_e2e_gate.cjs"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "planck": "1.4.3"
  }
}