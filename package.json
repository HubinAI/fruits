{
  "name": "zuiqiang-shuiguo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "《最强水果》Phase 01 — Physics Foundation / Battle Runtime / Physics Lab",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --open",
    "dev:mobile": "vite --host 0.0.0.0",
    "dev:player": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "build:wechat": "vite build -c vite.wechat.config.ts",
    "build:wechat:rc": "node scripts/wechat-rc.js",
    "build:wechat:rca": "node scripts/wechat-rca.js",
    "dev:wechat": "node scripts/wechat-dev.js",
    "build:pages": "vite build -c vite.pages.config.ts",
    "dev:run-page": "vite --open=/run-page.html",
    "dev:next-run": "vite --open=/next-run.html",
    "dev:encounter-lab": "vite --open=/encounter-lab.html",
    "dev:validation": "vite --open=/validation-hub.html",
    "dev:content-batch": "vite --open=/content-batch.html",
    "dev:home": "vite --open=/home.html",
    "dev:legacy": "vite --open=/index.html",
    "dev:debug-lab": "vite --open=/portrait-lab.html",
    "build:portrait-lab": "vite build -c vite.portrait-lab.config.ts",
    "e2e:portrait-lab": "node tests/_e2e_portrait_battle_lab.cjs",
    "e2e:run-page": "node tests/_e2e_run_page.cjs",
    "e2e:next-run": "node tests/_e2e_next_run.cjs",
    "e2e:encounter-lab": "node tests/_e2e_encounter_lab.cjs",
    "e2e:validation-hub": "node tests/_e2e_validation_hub.cjs",
    "e2e:default-entry": "node tests/_e2e_prp_default_entry.cjs",
    "e2e:product-home": "node tests/_e2e_product_home.cjs",
    "e2e:product-reward": "node tests/_e2e_product_reward.cjs",
    "e2e:product-loop": "node tests/_e2e_product_loop.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e-gate": "npm run build:e2e && node tests/_serve_pages.cjs & node tests/_e2e_gate.cjs",
    "build:e2e": "vite build -c vite.e2e.config.ts"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "planck": "1.4.3"
  }
}